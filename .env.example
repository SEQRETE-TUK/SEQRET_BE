SEQRET_APP_NAME=SEQRET Backend
SEQRET_SERVICE_NAME=seqret
SEQRET_ENVIRONMENT=local
SEQRET_DEBUG=false
SEQRET_LOG_LEVEL=INFO
SEQRET_API_PREFIX=/api/v1
SEQRET_DATABASE_URL=postgresql+psycopg://seqret:seqret@localhost:5432/seqret
SEQRET_DATABASE_POOL_SIZE=5
SEQRET_DATABASE_MAX_OVERFLOW=10
SEQRET_DATABASE_POOL_TIMEOUT_SECONDS=30
SEQRET_REDIS_URL=
SEQRET_REDIS_MAX_CONNECTIONS=10
SEQRET_CACHE_TIMEOUT_SECONDS=0.2
SEQRET_ACCESS_RATE_LIMIT_REQUESTS=120
SEQRET_ACCESS_RATE_LIMIT_WINDOW_SECONDS=60
SEQRET_PUBSUB_PROJECT_ID=
SEQRET_PUBSUB_TOPIC_ID=
SEQRET_OUTBOX_BATCH_SIZE=100
SEQRET_OUTBOX_LEASE_SECONDS=60
SEQRET_EVENT_PUBLISH_TIMEOUT_SECONDS=10
